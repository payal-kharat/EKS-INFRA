
pipeline {
    agent any
    parameters {
        choice(
            name: 'ENVIRONMENT',
            choices: ['dev', 'qa', 'uat', 'prod'],
            description: 'Select the Terraform environment'
        )
        choice(
            name: 'ACTION',
            choices: ['PLAN', 'APPLY', 'DESTROY'],
            description: 'Select Terraform action'
        )
    }
    environment {
        AWS_REGION       = 'us-east-1'
        AWS_CRED         = 'AWS'
        TF_IN_AUTOMATION = 'true'
        TF_INPUT         = 'false'
    }
    stages {
        stage('Validate Parameters') {
            steps {
                script {
                    if (!params.ENVIRONMENT) {
                        error('ENVIRONMENT must be selected.')
                    }
                    if (!params.ACTION) {
                        error('ACTION must be selected.')
                    }
                }
            }
        }
        stage('Terraform Init') {
            steps {
                dir('INFRA') {
                    withCredentials([
                        [$class: 'AmazonWebServicesCredentialsBinding',
                         credentialsId: "${AWS_CRED}"]
                    ]) {
                        sh '''

                        sh '''
    set -e
    echo "===== CURRENT DIRECTORY ====="
    pwd

    echo "===== DIRECTORY CONTENT ====="
    ls -la

    echo "===== backend_conf ====="
    ls -la backend_conf || true

    echo "===== SEARCH BACKEND FILE ====="
    find . -name "backend_dev.conf" -print
'''
                            set -e
                            export AWS_DEFAULT_REGION="$AWS_REGION"
                            BACKEND_CONFIG="backend_conf/backend_${ENVIRONMENT}.conf"
                            
                            TFVARS_FILE="env/${ENVIRONMENT}.tfvars"
                            if [ ! -f "$BACKEND_CONFIG" ]; then
                                echo "ERROR: Backend configuration not found: $BACKEND_CONFIG"
                                exit 1
                            fi
                            if [ ! -f "$TFVARS_FILE" ]; then
                                echo "ERROR: Terraform variable file not found: $TFVARS_FILE"
                                exit 1
                            fi
                            echo "=========================================="
                            echo "Terraform Environment : ${ENVIRONMENT}"
                            echo "Terraform Action      : ${ACTION}"
                            echo "Terraform Backend     : ${BACKEND_CONFIG}"
                            echo "Terraform Variables   : ${TFVARS_FILE}"
                            echo "=========================================="

                            rm -rf .terraform
                            terraform init \
                                -input=false \
                                -reconfigure \
                                -backend-config="$BACKEND_CONFIG"
                           
                            echo "Terraform backend initialized successfully"
                            echo "=========================================="
                        '''
                    }
                }
            }
        }
        stage('Terraform Format') {
            steps {
                dir('INFRA') {
                    sh '''
                        set -e
                        terraform fmt -recursive
                    '''
                }
            }
        }
        stage('Terraform Validate') {
            steps {
                dir('INFRA') {
                    sh '''
                        set -e
                        terraform validate
                    '''
                }
            }
        }
        stage('Terraform Plan') {
            when {
                expression {
                    return params.ACTION == 'PLAN' || params.ACTION == 'APPLY'
                }
            }
            steps {
                dir('INFRA') {
                    withCredentials([
                        [$class: 'AmazonWebServicesCredentialsBinding',
                         credentialsId: "${AWS_CRED}"]
                    ]) {
                        sh '''
                            set -e
                            export AWS_DEFAULT_REGION="$AWS_REGION"
                            terraform plan \
                                -input=false \
                                -var-file="env/${ENVIRONMENT}.tfvars" \
                                -out="tfplan-${ENVIRONMENT}"
                            echo "=========================================="
                            echo "Terraform plan completed successfully"
                            echo "Environment: ${ENVIRONMENT}"
                            echo "=========================================="
                        '''
                    }
                }
            }
        }
        stage('Manual Approval - Apply') {
            when {
                expression {
                    return params.ACTION == 'APPLY'
                }
            }
            steps {
                input(
                    message: "Approve Terraform APPLY for ${params.ENVIRONMENT}?",
                    ok: 'Approve Apply'
                )
            }
        }
        stage('Terraform Apply') {
            when {
                expression {
                    return params.ACTION == 'APPLY'
                }
            }
            steps {
                dir('INFRA') {
                    withCredentials([
                        [$class: 'AmazonWebServicesCredentialsBinding',
                         credentialsId: "${AWS_CRED}"]
                    ]) {
                        sh '''
                            set -e
                            export AWS_DEFAULT_REGION="$AWS_REGION"
                            terraform apply \
                                -input=false \
                                -auto-approve \
                                "tfplan-${ENVIRONMENT}"
                            echo "=========================================="
                            echo "Terraform apply completed successfully"
                            echo "Environment: ${ENVIRONMENT}"
                            echo "=========================================="
                        '''
                    }
                }
            }
        }
        stage('Terraform Destroy Plan') {
            when {
                expression {
                    return params.ACTION == 'DESTROY'
                }
            }
            steps {
                dir('INFRA') {
                    withCredentials([
                        [$class: 'AmazonWebServicesCredentialsBinding',
                         credentialsId: "${AWS_CRED}"]
                    ]) {
                        sh '''
                            set -e
                            export AWS_DEFAULT_REGION="$AWS_REGION"
                            echo "=========================================="
                            echo "WARNING: Terraform DESTROY PLAN"
                            echo "Environment: ${ENVIRONMENT}"
                            echo "=========================================="
                            terraform plan \
                                -destroy \
                                -input=false \
                                -var-file="env/${ENVIRONMENT}.tfvars" \
                                -out="destroy-${ENVIRONMENT}"
                            echo "=========================================="
                            echo "Terraform destroy plan completed"
                            echo "Environment: ${ENVIRONMENT}"
                            echo "=========================================="
                        '''
                    }
                }
            }
        }
        stage('Manual Approval - Destroy') {
            when {
                expression {
                    return params.ACTION == 'DESTROY'
                }
            }
            steps {
                input(
                    message: "WARNING: Approve Terraform DESTROY for ${params.ENVIRONMENT}?",
                    ok: 'Approve Destroy'
                )
            }
        }
        stage('Terraform Destroy') {
            when {
                expression {
                    return params.ACTION == 'DESTROY'
                }
            }
            steps {
                dir('INFRA') {
                    withCredentials([
                        [$class: 'AmazonWebServicesCredentialsBinding',
                         credentialsId: "${AWS_CRED}"]
                    ]) {
                        sh '''
                            set -e
                            export AWS_DEFAULT_REGION="$AWS_REGION"
                            terraform apply \
                                -input=false \
                                -auto-approve \
                                "destroy-${ENVIRONMENT}"
                            echo "=========================================="
                            echo "Terraform destroy completed"
                            echo "Environment: ${ENVIRONMENT}"
                            echo "=========================================="
                        '''
                    }
                }
            }
        }
    }
    post {
        success {
            echo "Terraform ${params.ACTION} for ${params.ENVIRONMENT} completed successfully."
        }
        failure {
            echo "Terraform ${params.ACTION} for ${params.ENVIRONMENT} failed."
        }
        always {
            echo "Terraform environment: ${params.ENVIRONMENT}"
            dir('INFRA') {
                sh '''
                    rm -f tfplan-${ENVIRONMENT} 2>/dev/null || true
                    rm -f destroy-${ENVIRONMENT} 2>/dev/null || true
                '''
            }
        }
    }
}

