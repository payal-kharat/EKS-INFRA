pipeline {

    agent any

    parameters {

        choice(
            name: 'ENVIRONMENT',
            choices: ['dev', 'qa', 'uat', 'prod'],
            description: 'Select the environment'
        )

        choice(
            name: 'ACTION',
            choices: ['PLAN', 'APPLY', 'DESTROY'],
            description: 'Select Terraform action'
        )
    }

    environment {

        AWS_REGION = 'us-east-1'

        AWS_CREDENTIALS = 'AWS'

        TF_IN_AUTOMATION = 'true'

        TF_INPUT = 'false'
    }

    stages {

        stage('Terraform Init') {

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    sh '''
                        terraform init
                    '''
                }
            }
        }

        stage('Terraform Format') {

            steps {

                sh '''
                    terraform fmt -recursive
                '''
            }
        }

        stage('Terraform Validate') {

            steps {

                sh '''
                    terraform validate
                '''
            }
        }

        stage('Terraform Plan') {

            when {
                expression {
                    return params.ACTION == 'PLAN' ||
                           params.ACTION == 'APPLY'
                }
            }

            steps {

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    sh '''
                        terraform plan \
                          -var-file="env/${ENVIRONMENT}.tfvars" \
                          -out="tfplan"
                    '''
                }
            }
        }

        stage('Terraform Apply') {

            when {
                expression {
                    return params.ACTION == 'APPLY'
                }
            }

            steps {

                input(
                    message: "Apply ${params.ENVIRONMENT} Terraform infrastructure?",
                    ok: "APPLY"
                )

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    sh '''
                        terraform apply -auto-approve tfplan
                    '''
                }
            }
        }

        stage('Terraform Destroy') {

            when {
                expression {
                    return params.ACTION == 'DESTROY'
                }
            }

            steps {

                input(
                    message: "WARNING: DESTROY ${params.ENVIRONMENT} infrastructure?",
                    ok: "DESTROY"
                )

                withCredentials([
                    [$class: 'AmazonWebServicesCredentialsBinding',
                     credentialsId: "${AWS_CREDENTIALS}"]
                ]) {

                    sh '''
                        terraform destroy \
                          -var-file="env/${ENVIRONMENT}.tfvars" \
                          -auto-approve
                    '''
                }
            }
        }

        stage('Terraform Output') {

            when {
                expression {
                    return params.ACTION == 'APPLY'
                }
            }

            steps {

                sh '''
                    terraform output
                '''
            }
        }
    }

    post {

        always {

            sh '''
                rm -f tfplan
            '''
        }

        success {

            echo "Terraform ${params.ACTION} for ${params.ENVIRONMENT} completed successfully."
        }

        failure {

            echo "Terraform ${params.ACTION} for ${params.ENVIRONMENT} failed."
        }
    }
}